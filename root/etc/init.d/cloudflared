#!/bin/sh /etc/rc.common
# luci-app-cloudflared - procd service for cloudflared tunnel
# All settings come from /etc/config/cloudflared (UCI).

USE_PROCD=1
START=99
STOP=10

PROG=/usr/sbin/cloudflared
TOKEN_FILE=/etc/cloudflared/tunnel-token
EXAMPLE=/etc/cloudflared/config.yml.example
RUN_DIR=/var/run/cloudflared

uci_val() {
	_v=$(uci -q get "cloudflared.$1.$2" 2>/dev/null)
	if [ -n "$_v" ]; then printf '%s' "$_v"; else printf '%s' "${3:-}"; fi
}

# --token-file was added in cloudflared 2025.4.0. Older binaries only accept
# --token, which exposes the secret in `ps`; warn when we have to fall back.
supports_token_file() {
	_v=$("$PROG" --version 2>/dev/null | awk '{print $3; exit}')
	case "$_v" in
		[0-9][0-9][0-9][0-9].[0-9]*) ;;
		*) return 1 ;;
	esac
	_y=${_v%%.*}
	_rest=${_v#*.}
	_m=${_rest%%.*}
	[ "$_y" -gt 2025 ] && return 0
	[ "$_y" -eq 2025 ] && [ "$_m" -ge 4 ] && return 0
	return 1
}

setup_cron() {
	[ -x /usr/sbin/cloudflared-ctl ] || return 0
	/usr/sbin/cloudflared-ctl cron-setup >/dev/null 2>&1 || true
}

start_service() {
	# cron must be rebuilt even when the tunnel itself is switched off:
	# users may want scheduled binary updates before enabling the tunnel.
	setup_cron

	_enabled=$(uci_val main enabled 0)
	[ "$_enabled" = '1' ] || return 0

	if [ ! -x "$PROG" ]; then
		logger -t cloudflared -p user.err 'binary missing, use LuCI -> Cloudflared -> 升级 to install it'
		return 1
	fi

	_mode=$(uci_val main mode token)
	_protocol=$(uci_val main protocol auto)
	_loglevel=$(uci_val main loglevel info)
	_metrics=$(uci_val main metrics_addr '')
	_extra=$(uci_val main extra_args '')
	_config=$(uci_val main config_file /etc/cloudflared/config.yml)

	[ "$(uci_val main tune_rmem 1)" = '1' ] &&
		sysctl -w net.core.rmem_max=2500000 >/dev/null 2>&1

	mkdir -p "$RUN_DIR" /etc/cloudflared
	chmod 700 /etc/cloudflared

	if [ "$_mode" = 'config' ] && [ ! -f "$_config" ] && [ -f "$EXAMPLE" ]; then
		cp "$EXAMPLE" "$_config"
		chmod 600 "$_config"
	fi

	set -- "$PROG" tunnel --no-autoupdate
	[ -n "$_protocol" ] && [ "$_protocol" != 'auto' ] && set -- "$@" --protocol "$_protocol"
	[ -n "$_loglevel" ] && set -- "$@" --loglevel "$_loglevel"
	[ -n "$_metrics" ] && set -- "$@" --metrics "$_metrics"
	[ "$_mode" = 'config' ] && set -- "$@" --config "$_config"
	set -- "$@" run

	if [ "$_mode" = 'token' ]; then
		if [ ! -s "$TOKEN_FILE" ]; then
			logger -t cloudflared -p user.err 'no tunnel token configured'
			return 1
		fi
		if supports_token_file; then
			set -- "$@" --token-file "$TOKEN_FILE"
		else
			logger -t cloudflared -p user.warn 'cloudflared < 2025.4.0: falling back to --token (secret visible in ps), please upgrade'
			set -- "$@" --token "$(cat "$TOKEN_FILE")"
		fi
	fi

	# extra_args is intentionally split on whitespace with globbing disabled.
	if [ -n "$_extra" ]; then
		set -f
		for _a in $_extra; do set -- "$@" "$_a"; done
		set +f
	fi

	procd_open_instance
	procd_set_param command "$@"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger 'cloudflared'
}
