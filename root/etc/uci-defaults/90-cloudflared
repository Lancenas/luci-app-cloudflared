#!/bin/sh
# First-boot / post-install housekeeping for luci-app-cloudflared.
# Safe to run more than once.

KEEP=/etc/sysupgrade.conf
RCLOCAL=/etc/rc.local
MARKER='luci-app-cloudflared'
HOOK='/etc/cloudflared/post-upgrade.sh'

mkdir -p /etc/cloudflared /var/run/cloudflared /etc/crontabs
chmod 700 /etc/cloudflared
chmod 755 /var/run/cloudflared

[ -f /etc/cloudflared/config.yml ] || cp /etc/cloudflared/config.yml.example /etc/cloudflared/config.yml
chmod 600 /etc/cloudflared/config.yml
[ -f /etc/cloudflared/tunnel-token ] && chmod 600 /etc/cloudflared/tunnel-token

# Make sure both UCI sections and all their options exist after an upgrade,
# including when another cloudflared package left a differently shaped config
# behind (e.g. a single "config cloudflared 'config'" section). Never overwrite
# an existing value.
uci -q get cloudflared.main >/dev/null 2>&1 || uci -q set cloudflared.main='cloudflared'
uci -q get cloudflared.update >/dev/null 2>&1 || uci -q set cloudflared.update='update'

ensure_opt() {
	uci -q get "cloudflared.$1.$2" >/dev/null 2>&1 || uci -q set "cloudflared.$1.$2=$3"
}
for pair in \
	'main enabled=0' 'main mode=token' 'main protocol=auto' 'main loglevel=info' \
	'main metrics_addr=' 'main extra_args=' 'main tune_rmem=1' \
	'main config_file=/etc/cloudflared/config.yml' \
	'update channel=stable' 'update pinned_version=' 'update auto_update=0' \
	'update auto_update_time=30 3 * * *' 'update github_token=' \
	'update download_mirror=' 'update arch_override=auto' \
	'update verify_sha256=1' 'update keep_backup=1' 'update last_update='
do
	_sec=${pair%% *}
	_rest=${pair#* }
	_opt=${_rest%%=*}
	_val=${_rest#*=}
	ensure_opt "$_sec" "$_opt" "$_val"
done
uci -q commit cloudflared

# Migrate a plaintext token left in an older/other cloudflared UCI config into
# our 0600 token file. Keep the original UCI value untouched so the other
# package is not broken; the token never appears in our process command line.
if [ ! -s /etc/cloudflared/tunnel-token ]; then
	_old_token=$(uci -q get cloudflared.config.token 2>/dev/null)
	[ -n "$_old_token" ] || _old_token=$(uci -q get cloudflared.@cloudflared[0].token 2>/dev/null)
	if [ -n "$_old_token" ]; then
		umask 077
		printf '%s\n' "$_old_token" > /etc/cloudflared/tunnel-token
		chmod 600 /etc/cloudflared/tunnel-token
		umask 022
	fi
fi

# sysupgrade replaces the root filesystem, including the ~40 MB binary.
# Keep our small files so the boot hook can fetch the binary again.
add_keep() {
	[ -f "$KEEP" ] || : > "$KEEP"
	grep -qxF "$1" "$KEEP" 2>/dev/null || printf '%s\n' "$1" >> "$KEEP"
}
add_keep '/etc/config/cloudflared'
add_keep '/etc/cloudflared/'
add_keep '/etc/init.d/cloudflared'
add_keep '/etc/rc.local'
add_keep '/etc/crontabs/root'
add_keep '/usr/sbin/cloudflared-ctl'
add_keep '/usr/sbin/cloudflared-update'
add_keep '/usr/share/luci/menu.d/luci-app-cloudflared.json'
add_keep '/usr/share/rpcd/acl.d/luci-app-cloudflared.json'
add_keep '/www/luci-static/resources/view/cloudflared/'

# Per-architecture packages ship the ~35 MB binary inside the ipk. Keep it
# across sysupgrade too, so an offline router does not have to re-download it.
# The generic "all" package has no bundled binary and keeps the old behaviour
# (the rc.local hook re-downloads it after a sysupgrade).
[ -f /etc/cloudflared/package-arch ] && add_keep '/usr/sbin/cloudflared'

# One boot hook, idempotent. rc.local is preserved by sysupgrade.
if [ -f "$RCLOCAL" ] && ! grep -qF "$MARKER" "$RCLOCAL"; then
	grep -v '^exit 0[[:space:]]*$' "$RCLOCAL" > "$RCLOCAL.tmp" || true
	mv "$RCLOCAL.tmp" "$RCLOCAL"
	cat >> "$RCLOCAL" <<EOF

# $MARKER: re-download cloudflared after sysupgrade
[ -x '$HOOK' ] && '$HOOK'
exit 0
EOF
	chmod 755 "$RCLOCAL"
fi

# rpcd reads ACL files at startup; reload so the menu and RPC work at once.
/etc/init.d/rpcd restart >/dev/null 2>&1 || true

exit 0
